<%= form_with model: company, class: "flex flex-col gap-3 max-w-lg" do |f| %>
  <%= render Ui::FormErrorsComponent.new(model: company) %>
  <fieldset class="fieldset"><%= f.label :name, class: "label" %><%= f.text_field :name, class: "input w-full", required: true %></fieldset>
  <fieldset class="fieldset"><%= f.label :domain, class: "label" %><%= f.text_field :domain, placeholder: "acme.com", class: "input w-full" %></fieldset>
  <%= render Ui::FormActionsComponent.new(submit_label: company.new_record? ? "Create company" : "Save", cancel_url: company.new_record? ? companies_path : company_path(company)) %>
<% end %>
