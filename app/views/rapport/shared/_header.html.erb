<div class="flex flex-wrap items-center justify-between gap-3 mb-8">
  <div class="flex items-center gap-2">
    <%= link_to "Rapport", root_path, class: "text-xl font-bold" %>
    <nav class="flex items-center gap-1 ml-4">
      <%= link_to "Contacts", contacts_path, class: "btn btn-ghost btn-sm #{'btn-active' if controller_name == 'contacts' && params[:due].blank?}" %>
      <%= link_to contacts_path(due: 1), class: "btn btn-ghost btn-sm #{'btn-active' if params[:due].present?}" do %>
        Due
        <% if defined?(@due_count) && @due_count.to_i > 0 %>
          <%= render Ui::BadgeComponent.new(variant: :warning, size: :sm, text: @due_count.to_s) %>
        <% end %>
      <% end %>
      <%= link_to "Companies", companies_path, class: "btn btn-ghost btn-sm #{'btn-active' if controller_name == 'companies'}" %>
    </nav>
  </div>
  <div class="flex items-center gap-2">
    <%= button_to "Sweep now", sweep_path, method: :post, class: "btn btn-sm btn-ghost", form: { class: "inline" } %>
    <%= link_to "Hub", main_app.hub_path, class: "btn btn-sm btn-ghost opacity-60" if main_app.respond_to?(:hub_path) %>
  </div>
</div>
<% if notice.present? %>
  <%= render Ui::AlertComponent.new(variant: :success, classes: "mb-4", text: notice) %>
<% end %>
<% if alert.present? %>
  <%= render Ui::AlertComponent.new(variant: :error, classes: "mb-4", text: alert) %>
<% end %>
