<% content_for :title, @contact.display_name %>
<%= render "rapport/shared/header" %>

<header class="flex flex-wrap items-start justify-between gap-4 mb-6">
  <div class="flex items-center gap-4 min-w-0">
    <div class="avatar <%= 'avatar-placeholder' if @contact.avatar_url.blank? %>">
      <div class="w-14 rounded-full bg-neutral text-neutral-content">
        <% if @contact.avatar_url.present? %>
          <%= image_tag @contact.avatar_url, alt: "" %>
        <% else %>
          <span class="text-lg font-semibold"><%= contact_initials(@contact) %></span>
        <% end %>
      </div>
    </div>
    <div class="min-w-0">
      <h1 class="text-2xl font-bold leading-tight truncate"><%= @contact.display_name %></h1>
      <p class="text-sm text-base-content/65">
        <%= [ @contact.job_title, (@contact.company && link_to(@contact.company.name, company_path(@contact.company), class: "link link-hover")) ].compact.join(" · ").html_safe %>
      </p>
      <div class="flex items-center gap-2 mt-1.5 text-xs text-base-content/60">
        <%= stage_badge(@contact.stage) %>
        <span>via <%= @contact.source %></span>
        <% if @contact.user_id %><span>· user #<%= @contact.user_id %></span><% end %>
        <% if @contact.phone.present? %><span>· <%= @contact.phone %></span><% end %>
      </div>
    </div>
  </div>
  <div class="flex items-center gap-2">
    <%= link_to "Edit", edit_contact_path(@contact), class: "btn btn-sm btn-ghost" %>
    <%= button_to "Mark as touched", touch_contact_path(@contact), method: :post, class: "btn btn-sm btn-primary", form: { class: "inline" } %>
  </div>
</header>

<div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_19rem] gap-6 items-start">
  <div class="flex flex-col gap-4 min-w-0">
    <%# Composer: one form, kind chosen with a segmented control. %>
    <%= render Ui::CardComponent.new(body_classes: "!p-4 gap-3") do %>
      <%= form_with url: contact_entries_path(@contact), method: :post, class: "flex flex-col gap-3" do |f| %>
        <div class="join">
          <% ([ "note" ] + Rapport::Interaction::KINDS).each_with_index do |kind, i| %>
            <input class="join-item btn btn-sm" type="radio" name="entry[kind]" value="<%= kind %>" aria-label="<%= kind.humanize %>" <%= "checked" if i.zero? %>>
          <% end %>
        </div>
        <%= f.text_area :body, rows: 3, placeholder: "Write a note, or what was said on the call…", class: "textarea w-full", required: true, **plain_field %>
        <div class="flex flex-wrap items-center gap-2">
          <%= f.datetime_local_field :occurred_at, value: Time.current.strftime("%Y-%m-%dT%H:%M"), class: "input input-sm w-52", title: "When it happened (interactions only)", **plain_field %>
          <%= f.text_field :other_emails, list: "rapport-addresses", placeholder: "Also with… (emails, comma separated)", class: "input input-sm flex-1 min-w-48", **plain_field %>
          <datalist id="rapport-addresses"><% @address_options.each do |name, address| %><option value="<%= address %>"><%= name %></option><% end %></datalist>
          <%= f.submit "Add to timeline", class: "btn btn-sm btn-primary" %>
        </div>
      <% end %>
    <% end %>

    <div class="flex items-baseline justify-between px-1">
      <h2 class="font-semibold">Timeline</h2>
      <span class="text-xs text-base-content/50"><%= @timeline_entries.size %> <%= "entry".pluralize(@timeline_entries.size) %></span>
    </div>
    <% if @timeline_entries.empty? %>
      <%= render Ui::EmptyStateComponent.new(title: "Nothing yet", description: "Entries appear after a sweep or when you add one above.") %>
    <% else %>
      <%= render Ui::CardComponent.new(body_classes: "!py-1 !px-4") do %>
        <ol class="flex flex-col divide-y divide-base-300">
          <% @timeline_entries.each do |entry| %>
            <%= render Rapport::TimelineEntryComponent.new(entry: entry) %>
          <% end %>
        </ol>
      <% end %>
    <% end %>
  </div>

  <aside class="flex flex-col gap-4">
    <%= render Ui::CardComponent.new(body_classes: "!p-4 gap-2") do %>
      <div class="flex items-baseline justify-between">
        <h2 class="font-semibold text-sm">Reminder</h2>
        <span class="text-xs text-base-content/50">last touch <%= @contact.last_touched_at ? rapport_ago(@contact.last_touched_at) : "never" %></span>
      </div>
      <% if (label, cadence, attention = touch_status(@contact)) %>
        <p class="text-sm"><span class="<%= 'text-warning font-medium' if attention %>"><%= label %></span> <span class="text-base-content/60">· <%= cadence %></span></p>
      <% else %>
        <p class="text-sm text-base-content/60">No reminder set.</p>
      <% end %>
      <%= form_with url: contact_reminder_path(@contact), method: :patch, class: "join" do |f| %>
        <%= f.number_field :reminder_cadence_days, value: @contact.reminder_cadence_days, min: 1, placeholder: "Days", class: "input input-sm join-item w-20", **plain_field %>
        <%= f.submit "Set", class: "btn btn-sm join-item" %>
        <% if @contact.reminder_cadence_days %>
          <%= button_to "Clear", contact_reminder_path(@contact), method: :patch, params: { reminder_cadence_days: "" }, class: "btn btn-sm btn-ghost join-item", form: { class: "contents" } %>
        <% end %>
      <% end %>
    <% end %>

    <%= render Ui::CardComponent.new(body_classes: "!p-4 gap-2") do %>
      <h2 class="font-semibold text-sm">Email addresses</h2>
      <ul class="text-sm flex flex-col gap-1">
        <% @contact.email_addresses.each do |email| %>
          <li class="flex items-center gap-2 min-w-0"><span class="truncate"><%= email.address %></span><% if email.primary? %><%= render Ui::BadgeComponent.new(size: :xs, soft: true, text: "primary") %><% end %></li>
        <% end %>
      </ul>
      <%= form_with url: contact_email_addresses_path(@contact), method: :post, class: "join" do |f| %>
        <%= f.email_field :address, placeholder: "Add address", class: "input input-sm join-item flex-1 min-w-0", required: true, **plain_field %>
        <%= f.submit "Add", class: "btn btn-sm join-item" %>
      <% end %>
    <% end %>

    <%= render Ui::CardComponent.new(body_classes: "!p-4 gap-2") do %>
      <h2 class="font-semibold text-sm">Tags</h2>
      <% if @contact.taggings.any? %>
        <div class="flex flex-wrap gap-1">
          <% @contact.taggings.includes(:tag).each do |tagging| %>
            <%= render Ui::BadgeComponent.new(size: :sm, soft: true, classes: "gap-1") do %>
              <%= tagging.tag.name %>
              <%= button_to "×", contact_tagging_path(@contact, tagging), method: :delete, class: "opacity-60 hover:opacity-100", form: { class: "inline" }, "aria-label": "Remove #{tagging.tag.name}" %>
            <% end %>
          <% end %>
        </div>
      <% end %>
      <%= form_with url: contact_taggings_path(@contact), method: :post, class: "join" do |f| %>
        <%= f.text_field :name, list: "rapport-tag-names", placeholder: "Add tag", class: "input input-sm join-item flex-1 min-w-0", required: true, **plain_field %>
        <datalist id="rapport-tag-names"><% @tag_names.each do |name| %><option value="<%= name %>"></option><% end %></datalist>
        <%= f.submit "Add", class: "btn btn-sm join-item" %>
      <% end %>
    <% end %>

    <%= render Ui::CardComponent.new(body_classes: "!p-4 gap-2") do %>
      <h2 class="font-semibold text-sm">Custom fields</h2>
      <% if @contact.custom_fields.any? %>
        <dl class="text-sm grid grid-cols-[auto_1fr] gap-x-3 gap-y-1">
          <% @contact.custom_fields.each do |key, value| %>
            <dt class="text-base-content/60"><%= key %></dt>
            <dd class="flex items-center gap-1 min-w-0"><span class="truncate"><%= value %></span>
              <%= button_to "×", contact_custom_fields_path(@contact), method: :patch, params: { key: key, value: "" }, class: "opacity-40 hover:opacity-100", form: { class: "inline" }, "aria-label": "Remove #{key}" %>
            </dd>
          <% end %>
        </dl>
      <% end %>
      <%= form_with url: contact_custom_fields_path(@contact), method: :patch, class: "join" do |f| %>
        <%= f.text_field :key, placeholder: "Field", class: "input input-sm join-item w-24", required: true, **plain_field %>
        <%= f.text_field :value, placeholder: "Value", class: "input input-sm join-item flex-1 min-w-0", required: true, **plain_field %>
        <%= f.submit "Save", class: "btn btn-sm join-item" %>
      <% end %>
    <% end %>

    <%= render Ui::DisclosureComponent.new(title: "Merge or delete") do %>
      <p class="text-xs text-base-content/60 mb-2">Fold another contact into this one. This contact survives.</p>
      <%= form_with url: merge_contact_path(@contact), method: :post, class: "join w-full" do |f| %>
        <%= f.email_field :other_email, list: "rapport-addresses", placeholder: "Other contact's email", class: "input input-sm join-item flex-1 min-w-0", required: true, **plain_field %>
        <%= f.submit "Merge", class: "btn btn-sm btn-warning join-item", data: { turbo_confirm: "Merge into #{@contact.display_name}? This cannot be undone." } %>
      <% end %>
      <div class="mt-4">
        <%= button_to "Delete this contact", contact_path(@contact), method: :delete, class: "btn btn-sm btn-ghost text-error", form: { data: { turbo_confirm: "Delete this contact?" } } %>
      </div>
    <% end %>
  </aside>
</div>
