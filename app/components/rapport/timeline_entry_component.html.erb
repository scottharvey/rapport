<li class="flex gap-3 py-3">
  <div class="mt-0.5 shrink-0 w-7 h-7 rounded-full bg-base-200 flex items-center justify-center">
    <%= render Ui::IconComponent.new(name: icon_name, classes: "size-4 opacity-70") %>
  </div>
  <div class="min-w-0 flex-1">
    <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
      <% if link %>
        <%= link_to entry.title, link, class: "font-medium text-sm link link-primary link-hover", **link_attributes %>
      <% else %>
        <span class="font-medium text-sm"><%= entry.title %></span>
      <% end %>
      <% if show_kind? %><span class="text-xs opacity-50"><%= kind_label %></span><% end %>
      <span class="ml-auto flex items-center gap-2">
        <% if link %>
          <%= link_to link, class: "btn btn-xs btn-outline btn-primary gap-1", **link_attributes do %>
            <%= link_label %><% if external_link? %><span aria-hidden="true">↗</span><% end %>
          <% end %>
        <% end %>
        <time class="text-xs opacity-50" datetime="<%= entry.occurred_at.iso8601 %>"><%= timestamp %></time>
        <% if removable? %>
          <%= button_to "×", remove_path, method: :delete, class: "text-xs opacity-30 hover:opacity-100 hover:text-error leading-none", form: { class: "inline", data: { turbo_confirm: "Remove this #{entry.title.downcase} from the timeline?" } }, "aria-label": "Remove #{entry.title}" %>
        <% end %>
      </span>
    </div>
    <% if detail.present? %>
      <p class="text-sm opacity-70 whitespace-pre-line break-words"><%= detail %></p>
    <% end %>
  </div>
</li>
